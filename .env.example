# Copy to backend/.env. Never commit real values.
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://memoryai:memoryai@localhost:5432/memoryai
# Later stages: GEMINI_API_KEY, LLM_PROVIDER=gemini|ollama|fake
# Required. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Set to true when served over HTTPS
COOKIE_SECURE=false

# LLM: fake (default, offline echo bot) | gemini | ollama
LLM_PROVIDER=fake
# Free key from https://aistudio.google.com . Check your key's available models and limits there.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Ollama on CPU: use 3B or smaller (e.g. llama3.2:3b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Memory: fake (default, offline keyword matcher, lost on restart) | mem0
# mem0 needs: pip install -r backend/requirements-mem0.txt, a real LLM_PROVIDER (gemini/ollama), and `alembic upgrade head` (enables pgvector)
MEMORY_PROVIDER=fake

# Custom memory (our own pipeline): MEMORY_PROVIDER=custom
# Needs a Postgres with pgvector (docker compose up -d db; alembic upgrade head) and a real LLM_PROVIDER for good extraction.
# Embeddings: fake (offline, word overlap) | fastembed (real; pip install -r backend/requirements-embeddings.txt)
EMBEDDING_PROVIDER=fake
# Cosine-similarity gate for retrieval. Calibrate for your embedding model (see docs/memory-system.md).
MEMORY_MIN_SIMILARITY=0.45

# Password reset emails. "console" (default) prints the email, including the reset link, in the backend terminal. Dev only.
EMAIL_BACKEND=console
FRONTEND_URL=http://localhost:5173
# For real email use any SMTP provider with STARTTLS on port 587 (Gmail app password, Brevo, Mailtrap, ...):
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=MemoryAI <you@example.com>

# Memory de-duplication bands (custom provider). Uncalibrated defaults for bge-small; the Stage 9 evaluation will tune them.
# MEMORY_AUTO_MERGE_SIMILARITY=0.92
# MEMORY_REVIEW_SIMILARITY=0.65
